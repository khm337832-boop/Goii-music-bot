# Copy to .env for local development:  cp .env.example .env
# ⚠️ Never commit the real .env file. Rotate any token that was ever in Git.

# --- required ---
BOT_TOKEN=123456789:AA-your-telegram-bot-token
# Your bot's @username from @BotFather (without @) -> enables /link & t.me link
BOT_USERNAME=

# --- optional: cloud AI brain ---
# AI_PROVIDER=auto | gemini | groq | openai | openrouter | local
# Free Gemini key: https://aistudio.google.com/app/apikey
AI_PROVIDER=gemini
AI_API_KEY=
# Instead of AI_API_KEY you can use GEMINI_API_KEY / GROQ_API_KEY / OPENAI_API_KEY.
# GEMINI_API_KEY=
# Optional model override (otherwise a list of current models is tried).
# AI_MODEL=gemini-2.5-flash
# Any OpenAI-compatible endpoint (for a custom provider):
# AI_BASE_URL=https://api.example.com/v1
# AI_TIMEOUT=12

# --- tuning ---
MAX_SEARCH_RESULTS=5
AUDIO_QUALITY=96
MAX_FILE_MB=12
PORT=8080
